PORT=5000
MONGODB_URI=
# MONGO_URI is also supported for existing deployments.
JWT_SECRET=
FRONTEND_URL=https://meso-live-frontend.onrender.com

STREAMING_PROVIDER=webrtc
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Optional Chapa credentials. Empty keys enable non-crediting mock mode.
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
# Required before real payments can credit coins; server applies this rate.
CHAPA_COINS_PER_ETB=
# Configure this same secret hash in the Chapa webhook dashboard.
CHAPA_WEBHOOK_SECRET=
CHAPA_CALLBACK_URL=
CHAPA_RETURN_URL=
